void main() {
    var numbers = Vec<i32>::withCap(5000);
    for (i32 i = 0; i < 5000; i++) {
        if ((i % 2) == 0) {
            numbers.push(i * 3);
        } else {
            numbers.push(-i * 2);
        }
    }

    const r = numbers.range(0, numbers.count());

    for (usize i = r.1; i < r.2; i++) {
        numbers.set(i, numbers.at(i) + (i32)i);
    }

    println("Done. Element 2500: {}", numbers.at(2500));
}
